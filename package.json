{
  "name": "do-pool",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/gen-facet.mjs && node container/build.mjs && node web/build.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "dev:node": "npm run build && docker build -t do-pool-node:dev container",
    "test:parity": "node --import tsx --test --test-reporter=spec test/parity.test.ts",
    "test:lifecycle": "node --import tsx --test --test-reporter=spec --test-timeout=7200000 test/lifecycle.test.ts",
    "deploy:preview": "npm run build && wrangler deploy --env preview",
    "deploy:control": "npm run build && wrangler deploy --env control",
    "publish:examples": "node scripts/publish-examples.mjs",
    "test:examples": "node --import tsx --test --test-reporter=spec test/examples.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "workerd": "^1.20261014.1",
    "wrangler": "^4.151.0",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "codemirror": "^6.0.2",
    "lib0": "^0.2.119",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  }
}
