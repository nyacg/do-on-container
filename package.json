    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "workerd": "^1.20261014.1",
    "wrangler": "^4.151.0",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "codemirror": "^6.0.2",
    "lib0": "^0.2.119",
    "y-codemirror.next": "^0.3.6",
