// celld consumes the same Wrangler config as `wrangler deploy` (jsonc/json only, no toml).
// celld rejects unknown top-level keys (e.g. `routes`, `containers` for workerd-only setups),
// so keep this to the accepted subset: name/main/compatibility_*/durable_objects/migrations.
{
  "name": "celld-bench",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
